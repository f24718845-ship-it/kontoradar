# ==============================================================================
# KontoRadar - Environment Variables Template
# ==============================================================================
#
# INSTRUKCJA:
# Skopiuj ten plik do .env.local dla testów lokalnych lub ustaw te zmienne
# w panelu Cloudflare Pages (Settings -> Environment variables -> Production).
#
# ==============================================================================
# 1. GOOGLE ANALYTICS 4 (GA4)
# ==============================================================================
# Twój identyfikator pomiaru z Google Analytics (np. G-ABC1234567)
# Pobierz go w: Google Analytics -> Administracja -> Strumienie danych -> Identyfikator pomiaru
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ==============================================================================
# 2. GOOGLE SEARCH CONSOLE (GSC)
# ==============================================================================
# Twój token weryfikacyjny z metody "Tag HTML" w Search Console
# Wartość z atrybutu content: <meta name="google-site-verification" content="TOKEN" />
# Pobierz go w: Google Search Console -> Dodaj usługę (https://kontoradar.pages.dev) -> Tag HTML
NEXT_PUBLIC_GSC_VERIFICATION_TOKEN=
